# Unsubscribe Agent Configuration
# Copy this file to .env and configure your settings

# =============================================================================
# LLM Configuration
# =============================================================================

# LLM Provider and Model (choose one provider)
# Supported providers: google_genai, openai, anthropic
LLM_MODEL_PROVIDER=google_genai
LLM_MODEL_NAME=gemini-2.5-flash

# API Keys (only set the one for your chosen provider)
# Google Gemini API Key
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API Key (uncomment if using OpenAI)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (uncomment if using Anthropic)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# Browser Automation LLM Configuration
# =============================================================================

# Browser automation LLM provider (ollama or gemini)
BROWSER_LLM_PROVIDER=ollama

# Model for browser automation
# Popular options: tinyllama:1.1b, llama3.2:3b, llama3.2:1b, qwen2.5:3b, gemini-2.5-flash
BROWSER_MODEL_NAME=tinyllama:1.1b

# =============================================================================
# Application Settings
# =============================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Redis URL for task queue
REDIS_URL=redis://localhost:6379

# Browser settings
HEADLESS=true

# Use LLM only mode (skip browser automation)
USE_LLM_ONLY=false

# =============================================================================
# Example Configurations
# =============================================================================

# Example 1: Hybrid setup (Gemini for email, Ollama for browser)
# LLM_MODEL_PROVIDER=google_genai
# LLM_MODEL_NAME=gemini-2.5-flash
# GOOGLE_API_KEY=your_google_api_key_here
# BROWSER_LLM_PROVIDER=ollama
# BROWSER_MODEL_NAME=llama3.2:3b

# Example 2: All-Gemini setup (Gemini for both email and browser)
# LLM_MODEL_PROVIDER=google_genai
# LLM_MODEL_NAME=gemini-2.5-flash
# GOOGLE_API_KEY=your_google_api_key_here
# BROWSER_LLM_PROVIDER=gemini

# Example 3: Using OpenAI for email, Ollama for browser
# LLM_MODEL_PROVIDER=openai
# LLM_MODEL_NAME=gpt-4
# OPENAI_API_KEY=your_openai_api_key_here
# BROWSER_LLM_PROVIDER=ollama
# BROWSER_MODEL_NAME=llama3.2:3b

# Example 4: All-local setup (requires external provider for email)
# LLM_MODEL_PROVIDER=google_genai
# LLM_MODEL_NAME=gemini-2.5-flash
# GOOGLE_API_KEY=your_google_api_key_here
# BROWSER_LLM_PROVIDER=ollama
# BROWSER_MODEL_NAME=qwen2.5:3b
